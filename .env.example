# Copy to .env and fill in. .env is gitignored; this example is not.
GEMINI_API_KEY=your-google-ai-studio-key-here
# GEMINI_MODEL=gemini-flash-latest

# Path to adb.exe if it is not on your PATH (optional).
# ADB_PATH=C:\path\to\platform-tools\adb.exe


# Groq (fast LLM inference) key for the LLM Executor grounder (optional).
# Without it, grounding falls back to the keyword heuristic. Get one at https://console.groq.com
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b
